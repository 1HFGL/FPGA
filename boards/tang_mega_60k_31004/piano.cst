// 实物为NEO Dock31005 + 60K核心板，GW5AT-60B；目录名31004仅为历史路径。
// J13针号依据31005底板p19，经p7的BTB针号对照60K核心板p1，不能抄138K的Bank编号。
IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33;
IO_LOC "sys_rst_n" AA13;
IO_PORT "sys_rst_n" IO_TYPE=LVCMOS15 PULL_MODE=UP;
IO_LOC "Key_in[0]" AB13;
IO_PORT "Key_in[0]" IO_TYPE=LVCMOS15 PULL_MODE=UP;
IO_LOC "Key_in[1]" Y12;
IO_PORT "Key_in[1]" IO_TYPE=LVCMOS15 PULL_MODE=UP;
IO_LOC "HP_BCK" Y17;
IO_PORT "HP_BCK" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "HP_WS" AB17;
IO_PORT "HP_WS" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "HP_DIN" AA16;
IO_PORT "HP_DIN" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "PA_EN" AB16;
IO_PORT "PA_EN" IO_TYPE=LVCMOS33 DRIVE=8;
// BL616_IO28_TX经R57进入FPGA；反向由U15经R58到BL616_IO27_RX。
IO_LOC "uart_rx" V14;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "uart_tx" U15;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 DRIVE=8;
// ADS1115数字线迁到下方J13：16=SDRAM0_D10/B20，17=SDRAM0_D9/A21。
// 模块3.3V/GND仍从J8/J9取；J13-11为5V，禁止用作3.3V供电。
IO_LOC "knob_sda" B20;
IO_PORT "knob_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "knob_scl" A21;
IO_PORT "knob_scl" IO_TYPE=LVCMOS33 BANK_VCCIO=3.3;

// 八白键连续接J13-1..8，五黑键接9/10/13/14/15；内部仍按半音编号。
// 避开11=5V和12=GND；必须配套本轮新位流，不能沿用旧半音排列接线。
// 这些线为外部SDRAM0扩展线，不可同时连接SDRAM0外设；不涉及核心板DDR3。
IO_LOC "piano_key_n[0]" E14;
IO_LOC "piano_key_n[1]" B16;
IO_LOC "piano_key_n[2]" E13;
IO_LOC "piano_key_n[3]" B15;
IO_LOC "piano_key_n[4]" C15;
IO_LOC "piano_key_n[5]" C14;
IO_LOC "piano_key_n[6]" A16;
IO_LOC "piano_key_n[7]" B13;
IO_LOC "piano_key_n[8]" A15;
IO_LOC "piano_key_n[9]" C13;
IO_LOC "piano_key_n[10]" A20;
IO_LOC "piano_key_n[11]" A14;
IO_LOC "piano_key_n[12]" A13;
IO_PORT "piano_key_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "piano_key_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "piano_key_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "piano_key_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "piano_key_n[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "piano_key_n[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "piano_key_n[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "piano_key_n[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "piano_key_n[8]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "piano_key_n[9]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "piano_key_n[10]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "piano_key_n[11]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "piano_key_n[12]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
