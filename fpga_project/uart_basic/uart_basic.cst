// NEO Dock31004 Rev1.4，GW5AT-60B；依据已核对的底板/核心板原理图。
IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33;
IO_LOC "sys_rst_n" AA13;
IO_PORT "sys_rst_n" IO_TYPE=LVCMOS15 PULL_MODE=UP;
IO_LOC "Key_in[0]" AB13;
IO_PORT "Key_in[0]" IO_TYPE=LVCMOS15 PULL_MODE=UP;
IO_LOC "Key_in[1]" Y12;
IO_PORT "Key_in[1]" IO_TYPE=LVCMOS15 PULL_MODE=UP;
IO_LOC "HP_BCK" Y17;
IO_PORT "HP_BCK" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "HP_WS" AB17;
IO_PORT "HP_WS" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "HP_DIN" AA16;
IO_PORT "HP_DIN" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "PA_EN" AB16;
IO_PORT "PA_EN" IO_TYPE=LVCMOS33 DRIVE=8;
// BL616_IO28_TX经R57进入FPGA；反向由U15经R58到BL616_IO27_RX。
IO_LOC "uart_rx" V14;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "uart_tx" U15;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 DRIVE=8;
